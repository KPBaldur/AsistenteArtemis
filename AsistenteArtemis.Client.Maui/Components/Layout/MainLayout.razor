@inherits LayoutComponentBase
@inject AuthState AuthState
@implements IDisposable

@* AppShell del sistema "Luna de caza": barra lateral + contenido. Sin sesión
   (login/registro) el contenido va centrado y sin barra. *@
<div class="app-shell">
    @if (AuthState.IsAuthenticated)
    {
        <SideNav />
        <main class="app-content">
            @Body
        </main>
    }
    else
    {
        <main class="app-content app-content--center">
            @Body
        </main>
    }
</div>

@* Aviso de alarma sonando — visible sin importar qué pantalla esté mostrando el usuario. *@
<AlarmPopup />

@code {
    protected override void OnInitialized() => AuthState.Changed += OnAuthChanged;

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => AuthState.Changed -= OnAuthChanged;
}
