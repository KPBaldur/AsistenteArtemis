@inherits LayoutComponentBase
@inject AuthState AuthState
@inject MascotConnector MascotConnector
@implements IDisposable

@* AppShell del sistema "Luna de caza": barra lateral + contenido. Sin sesión
   (login/registro) el contenido va centrado y sin barra. *@
<div class="app-shell">
    @if (AuthState.IsAuthenticated)
    {
        <SideNav />
        <main class="app-content">
            @Body
        </main>
    }
    else
    {
        <main class="app-content app-content--center">
            @Body
        </main>
    }
</div>

@* Aviso de alarma sonando — visible sin importar qué pantalla esté mostrando el usuario. *@
<AlarmPopup />

@code {
    protected override void OnInitialized()
    {
        AuthState.Changed += OnAuthChanged;
        if (AuthState.IsAuthenticated)
            _ = MascotConnector.EnsureConnectedAsync();
    }

    // Con sesión, la mascota se conecta sola (a pedido del usuario, 2026-10-09); al cerrar
    // sesión, la próxima vuelve a verificar.
    private void OnAuthChanged()
    {
        if (AuthState.IsAuthenticated)
            _ = MascotConnector.EnsureConnectedAsync();
        else
            MascotConnector.ResetSessionCheck();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => AuthState.Changed -= OnAuthChanged;
}
