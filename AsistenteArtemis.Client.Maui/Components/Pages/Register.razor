@page "/register"
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation

<Card Class="auth-card">
    <div class="overline">Artemis</div>
    <h1>Crear cuenta</h1>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="form-group">
            <label for="reg-user">Usuario</label>
            <InputText id="reg-user" class="form-control" @bind-Value="_model.Username" />
        </div>
        <div class="form-group">
            <label for="reg-email">Email</label>
            <InputText id="reg-email" class="form-control" @bind-Value="_model.Email" />
        </div>
        <div class="form-group">
            <label for="reg-pass">Contraseña</label>
            <InputText id="reg-pass" class="form-control" type="password" @bind-Value="_model.Password" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-danger">@_error</p>
        }
        @if (_done)
        {
            <p class="text-success">Cuenta creada. Ya podés iniciar sesión.</p>
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Registrarme</button>
    </EditForm>

    <p class="mt-3 mb-0"><a href="/login">Ya tengo cuenta</a></p>
</Card>

@code {
    private readonly RegisterRequest _model = new();
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _done = false;
        try
        {
            // Register does NOT log the user in — the API returns only the created user, no
            // tokens (see AuthController.Register). Send them to Login on success.
            await AuthApi.RegisterAsync(_model);
            _done = true;
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo crear la cuenta (usuario/email ya existe, o datos inválidos).";
        }
        finally
        {
            _busy = false;
        }
    }
}
