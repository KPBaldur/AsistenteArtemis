@page "/identity"
@inject IAssistantIdentityApiClient IdentityApi
@inject MascotConnector MascotConnector
@inject AuthState AuthState
@inject NavigationManager Navigation

<h1>Identidad de Artemis</h1>

@if (!AuthState.IsAuthenticated)
{
    <p>Redirigiendo a login...</p>
}
else if (_model is null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <div class="form-group">
            <label>Nombre</label>
            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>
        <div class="form-group">
            <label>Tono</label>
            <InputText class="form-control" @bind-Value="_model.Tone" placeholder="ej: sarcástico, formal, cercano..." />
        </div>
        <div class="form-group">
            <label>Reglas de estilo</label>
            <InputTextArea class="form-control" rows="6" @bind-Value="_model.StyleRules" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-danger">@_error</p>
        }
        @if (_saved)
        {
            <p class="text-success">Guardado.</p>
        }

        <button type="submit" class="btn btn-primary" disabled="@_busy">Guardar</button>
    </EditForm>

    @if (_updatedAt.HasValue)
    {
        <p><small>Última actualización: @_updatedAt.Value.ToLocalTime().ToString("g")</small></p>
    }

    <Card Title="Mascota de escritorio" Class="mt-4">
        <p class="text-secondary-ui">
            La app conecta la mascota sola al iniciar sesión, para que pueda crear alarmas, notas y
            tareas y mostrar el estado de tus servidores. Usa un token propio: aquí puedes
            reconectarla o revocarlo cuando quieras.
        </p>
        @if (_mascotDevices is { Count: > 0 } && MascotLink.IsLinked)
        {
            <p>
                <StatusDot Kind="up" Label="Conectada" />
                Conectada desde @_mascotDevices[0].CreatedAt.ToLocalTime().ToString("g")
                @if (_mascotDevices[0].LastUsedAt is { } lastUsed)
                {
                    <span class="text-secondary-ui"> · último uso @lastUsed.ToLocalTime().ToString("g")</span>
                }
            </p>
            <div class="d-flex flex-wrap" style="gap: 10px;">
                @if (MascotLauncher.IsSupported)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenMascot">
                        @(MascotLauncher.IsRunning() ? "Mascota abierta" : "Abrir mascota")
                    </button>
                }
                <button type="button" class="btn btn-outline-danger" disabled="@_mascotBusy" @onclick="DisconnectMascotAsync">Desconectar</button>
            </div>
        }
        else
        {
            <button type="button" class="btn btn-primary" disabled="@_mascotBusy" @onclick="ConnectMascotAsync">Conectar mascota</button>
        }
        @if (!string.IsNullOrEmpty(_mascotMessage ?? MascotLauncher.LastError))
        {
            <p class="mt-2 mb-0">@(_mascotMessage ?? MascotLauncher.LastError)</p>
        }
    </Card>
}

@code {
    private FormModel? _model;
    private DateTime? _updatedAt;
    private string? _error;
    private bool _busy;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        try
        {
            var identity = await IdentityApi.GetIdentityAsync();
            _model = new FormModel { Name = identity.Name, Tone = identity.Tone, StyleRules = identity.StyleRules };
            _updatedAt = identity.UpdatedAt;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo cargar la identidad.";
            _model = new FormModel();
        }

        await LoadMascotDevicesAsync();
    }

    // --- Mascota de escritorio ---------------------------------------------------------

    private List<DeviceTokenDto>? _mascotDevices;
    private bool _mascotBusy;
    private string? _mascotMessage;

    private async Task LoadMascotDevicesAsync()
    {
        try
        {
            _mascotDevices = await MascotConnector.GetActiveTokensAsync();
        }
        catch (HttpRequestException)
        {
            _mascotMessage = "No se pudo consultar el estado de la mascota.";
        }
    }

    private async Task ConnectMascotAsync()
    {
        _mascotBusy = true;
        _mascotMessage = null;
        try
        {
            await MascotConnector.ReconnectAsync(_mascotDevices);
            _mascotMessage = "Listo. La mascota ya puede usar tu cuenta (si estaba abierta, lo nota en el próximo uso).";
            await LoadMascotDevicesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or UnauthorizedAccessException)
        {
            _mascotMessage = $"No se pudo conectar la mascota: {ex.Message}";
        }
        finally
        {
            _mascotBusy = false;
        }
    }

    private void OpenMascot()
    {
        var error = MascotLauncher.Launch();
        _mascotMessage = error ?? "Abriendo la mascota… aparece en la esquina inferior derecha.";
    }

    private async Task DisconnectMascotAsync()
    {
        _mascotBusy = true;
        _mascotMessage = null;
        try
        {
            await MascotConnector.DisconnectAsync();
            _mascotMessage = "Mascota desconectada: su token quedó revocado.";
            await LoadMascotDevicesAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or IOException or UnauthorizedAccessException)
        {
            _mascotMessage = $"No se pudo desconectar: {ex.Message}";
        }
        finally
        {
            _mascotBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_model is null)
            return;

        _busy = true;
        _saved = false;
        try
        {
            var updated = await IdentityApi.SaveIdentityAsync(new AssistantIdentityUpdateDto
            {
                Name = _model.Name,
                Tone = _model.Tone,
                StyleRules = _model.StyleRules
            });
            _updatedAt = updated.UpdatedAt;
            _saved = true;
            _error = null;
        }
        catch (HttpRequestException ex)
        {
            _error = $"No se pudo guardar: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Tone { get; set; } = string.Empty;
        public string StyleRules { get; set; } = string.Empty;
    }
}
