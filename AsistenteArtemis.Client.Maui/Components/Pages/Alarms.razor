@page "/alarms"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject IAlarmApiClient AlarmApi
@inject IMediaApiClient MediaApi
@inject IAudioManager AudioManager
@inject TokenStore TokenStore
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject AlarmNotificationService NotificationService

<h1>Alarmas</h1>

@if (!AuthState.IsAuthenticated)
{
    <p>Redirigiendo a login...</p>
}
else
{
    <p>
        Conexión en vivo:
        @if (_hubConnected)
        {
            <span style="color:green;">conectada</span>
        }
        else
        {
            <span style="color:#a60;">conectando...</span>
        }
    </p>

    @foreach (var ringing in _ringingAlarms)
    {
        <div style="background:#eef; border:1px solid #99f; padding:0.5em; margin-bottom:0.5em;">
            🔔 @GetRingingMessage(ringing)
            @if (!ringing.HasActiveBreak)
            {
                @if (ringing.Player is null)
                {
                    <span style="color:#669; font-style:italic;"> (esperando turno de audio)</span>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => PauseRingingAlarmAsync(ringing)">Pausar</button>
            }
            <button class="btn btn-sm btn-outline-danger" @onclick="() => StopRingingAlarmAsync(ringing)">Detener</button>
        </div>
    }

    <EditForm Model="_form" OnValidSubmit="SaveAlarmAsync">
        <div class="form-group">
            <InputText class="form-control" placeholder="Nombre" @bind-Value="_form.Name" />
        </div>
        <div class="form-group">
            <InputSelect class="form-control" @bind-Value="_form.Type" disabled="@(_editingId is not null)">
                @foreach (var type in Enum.GetValues<AlarmType>())
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
        </div>
        @if (_form.Type == AlarmType.Pomodoro)
        {
            <div class="form-group">
                <label>Repetir cada (minutos)</label>
                <InputNumber class="form-control" @bind-Value="_form.DurationMinutes" />
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" checked="@_form.PauseEnabled" @onchange="e => _form.PauseEnabled = e.Value is true" />
                    Habilitar pausa activa (el trabajo y el descanso se alternan solos, sin que tengas que hacer nada al sonar)
                </label>
            </div>
            @if (_form.PauseEnabled)
            {
                <div class="form-group">
                    <label>Minutos de pausa</label>
                    <InputNumber class="form-control" @bind-Value="_form.SnoozeMinutes" />
                </div>
            }
            <div class="form-group">
                <label>
                    <input type="checkbox" checked="@_form.Restricted" @onchange="e => _form.Restricted = e.Value is true" />
                    Restringir a días y horario específicos (si no, suena todo el tiempo)
                </label>
            </div>
            @if (_form.Restricted)
            {
                <div class="form-group">
                    @foreach (var (label, flag) in DayOptions)
                    {
                        <label style="margin-right:0.75em;">
                            <input type="checkbox" checked="@_form.SelectedDays.Contains(flag)" @onchange="e => ToggleDay(flag, e.Value)" />
                            @label
                        </label>
                    }
                </div>
                <div class="form-group">
                    <label>Desde</label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="_form.WindowStart" />
                </div>
                <div class="form-group">
                    <label>Hasta</label>
                    <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="_form.WindowEnd" />
                </div>
            }
        }
        else
        {
            <div class="form-group">
                <label>Fecha</label>
                <InputDate class="form-control" @bind-Value="_form.ScheduleDate" />
            </div>
            <div class="form-group">
                <label>Hora</label>
                <InputDate Type="InputDateType.Time" class="form-control" @bind-Value="_form.ScheduleTime" />
            </div>
        }
        <div class="form-group">
            <label>Audio</label>
            <InputSelect class="form-control" @bind-Value="_form.AudioId">
                <option value="">(sin audio)</option>
                @if (_mediaList is not null)
                {
                    @foreach (var media in _mediaList.Where(m => m.FileType == "audio"))
                    {
                        <option value="@media.Id">@media.Name</option>
                    }
                }
            </InputSelect>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PickAndUploadAudioAsync" disabled="@_uploadingAudio">
                @(_uploadingAudio ? "Subiendo..." : "Subir audio nuevo")
            </button>
        </div>
        <div class="form-group">
            <label>Volumen (@_form.Volume%)</label>
            <InputNumber class="form-control" @bind-Value="_form.Volume" min="0" max="100" />
        </div>
        <button type="submit" class="btn btn-primary" disabled="@_busy">@(_editingId is null ? "Crear alarma" : "Guardar cambios")</button>
        @if (_editingId is not null)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">Cancelar</button>
        }
    </EditForm>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="text-danger">@_error</p>
    }

    @if (_alarms is null)
    {
        <p>Cargando...</p>
    }
    else if (_alarms.Count == 0)
    {
        <p>No hay alarmas todavía.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var alarm in _alarms)
            {
                <li class="list-group-item">
                    <strong>@alarm.Name</strong> — @alarm.Type
                    @if (alarm.Type == AlarmType.Pomodoro)
                    {
                        <span> (cada @alarm.DurationMinutes min@(alarm.SnoozeMinutes is > 0 ? $", pausa de {alarm.SnoozeMinutes} min" : ""))</span>
                        @if (alarm.WindowStart.HasValue && alarm.WindowEnd.HasValue)
                        {
                            <span> — @DescribeDays(alarm.DaysOfWeek), @alarm.WindowStart.Value.ToString("HH\\:mm")-@alarm.WindowEnd.Value.ToString("HH\\:mm")</span>
                        }
                        else
                        {
                            <span> — todo el tiempo</span>
                        }
                    }
                    else if (alarm.ScheduleAt.HasValue)
                    {
                        <span> (@alarm.ScheduleAt.Value.ToLocalTime().ToString("g"))</span>
                    }
                    <div>
                        <span class="badge @(alarm.IsActive ? "bg-success" : "bg-secondary")">@(alarm.IsActive ? "Activa" : "Pausada")</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleActiveAsync(alarm)">
                            @(alarm.IsActive ? "Pausar" : "Reanudar")
                        </button>
                        @if (alarm.IsActive)
                        {
                            <input type="number" min="1" class="form-control d-inline-block" style="width:5em;" value="@GetSnoozeMinutes(alarm.Id)" @onchange="e => SetSnoozeMinutes(alarm.Id, e.Value?.ToString())" />
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SnoozeAsync(alarm)">Dormir</button>
                        }
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAlarm(alarm)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger float-end" @onclick="() => DeleteAlarmAsync(alarm.Id)">Borrar</button>
                    </div>
                </li>
            }
        </ul>
    }
}

@code {
    private static readonly (string Label, AlarmDaysOfWeek Flag)[] DayOptions =
    [
        ("Lun", AlarmDaysOfWeek.Monday), ("Mar", AlarmDaysOfWeek.Tuesday), ("Mié", AlarmDaysOfWeek.Wednesday),
        ("Jue", AlarmDaysOfWeek.Thursday), ("Vie", AlarmDaysOfWeek.Friday), ("Sáb", AlarmDaysOfWeek.Saturday),
        ("Dom", AlarmDaysOfWeek.Sunday)
    ];

    private List<AlarmDto>? _alarms;
    private List<MediaDto>? _mediaList;
    private AlarmFormModel _form = new();
    private Guid? _editingId;
    private readonly Dictionary<Guid, int> _snoozeMinutes = new();
    private string? _error;
    private bool _busy;
    private bool _uploadingAudio;
    private bool _hubConnected;
    private readonly List<RingingAlarm> _ringingAlarms = new();
    // Turnos de audio: el banner de cada alarma sonando aparece de inmediato, pero el audio de
    // cada una espera su turno acá — nunca suenan dos mezcladas.
    private readonly Queue<(RingingAlarm Ringing, string Url, int? VolumePercent, bool IsPrimary)> _pendingAudio = new();
    private bool _audioSlotBusy;
    private HubConnection? _hubConnection;

    private class RingingAlarm
    {
        public Guid AlarmId { get; set; }
        public string Name { get; set; } = string.Empty;
        // Referencia al reproductor real que quedó sonando — sin esto, Pausar/Detener solo
        // reprogramaban la alarma del lado del servidor pero el audio seguía sonando solo.
        // ManagedAlarmAudio (Services/ManagedAlarmAudio.cs) trae su propio guard contra la
        // reentrada de Plugin.Maui.Audio en WinUI (Dispose -> Stop -> PlaybackEnded -> Dispose
        // de nuevo, que sin guard revienta la pila) — compartido con AlarmNotificationService
        // para el audio "headless" cuando esta página no está abierta.
        public ManagedAlarmAudio? Player { get; set; }
        // Ciclo automático trabajo/descanso (Pausa Activa habilitada): banner sin Pausar, chime
        // corto en vez del audio largo configurado, se autodescarta solo.
        public bool HasActiveBreak { get; set; }
        public string? PhaseJustEnded { get; set; } // "Work" | "Break"
    }

    // Mismo texto que usa el toast nativo (NativeNotifications, vía AlarmNotificationService) —
    // un solo lugar para la lógica del mensaje, no duplicada en los dos.
    private static string GetRingingMessage(RingingAlarm ringing) =>
        NativeNotifications.BuildRingingMessage(ringing.Name, ringing.HasActiveBreak, ringing.PhaseJustEnded);

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        // Mientras esta página está abierta, ella se encarga del audio real (cola de turnos,
        // banner) — AlarmNotificationService se calla para no duplicar el sonido.
        NotificationService.IsAlarmsPageActive = true;

        await LoadAlarmsAsync();
        await LoadMediaAsync();
        await ConnectHubAsync();
    }

    private async Task LoadAlarmsAsync()
    {
        try
        {
            _alarms = await AlarmApi.GetAlarmsAsync();
            foreach (var alarm in _alarms)
            {
                if (!_snoozeMinutes.ContainsKey(alarm.Id))
                    _snoozeMinutes[alarm.Id] = alarm.Type == AlarmType.Pomodoro && alarm.DurationMinutes is > 0
                        ? alarm.DurationMinutes.Value
                        : 5;
            }
            _error = null;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudieron cargar las alarmas.";
        }
    }

    private async Task LoadMediaAsync()
    {
        try
        {
            _mediaList = await MediaApi.GetMediaAsync();
        }
        catch (HttpRequestException)
        {
            // No bloquea el resto de la pantalla — simplemente no habrá audios para elegir.
        }
    }

    private async Task ConnectHubAsync()
    {
        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{ApiConfig.HubBaseUrl}/hubs/alarms", options =>
            {
                options.AccessTokenProvider = () => TokenStore.GetAccessTokenAsync();
            })
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<AlarmTriggeredPayload>("ReceiveAlarmTrigger", payload =>
        {
            InvokeAsync(async () =>
            {
                // El aviso/banner de esta alarma aparece ya, aunque otra siga sonando — el audio
                // en cambio espera su turno (ver PlayNextQueuedAudioAsync): nunca suenan dos a la
                // vez, para no mezclarse.
                var ringing = new RingingAlarm
                {
                    AlarmId = payload.AlarmId,
                    Name = payload.Name,
                    HasActiveBreak = payload.HasActiveBreak == true,
                    PhaseJustEnded = payload.PhaseJustEnded
                };
                _ringingAlarms.Add(ringing);
                // El toast nativo de Windows lo manda AlarmNotificationService (conexión propia,
                // a nivel de toda la app) — no acá, para no duplicarlo mientras esta página está
                // abierta (las dos conexiones reciben el mismo evento).

                if (ringing.HasActiveBreak)
                {
                    // Ciclo automático (Pausa Activa): chime corto, no el audio largo
                    // configurado — el servidor ya reprogramó la siguiente fase solo.
                    _ = PlayPhaseChimeAsync(ringing);
                }
                else if (!string.IsNullOrEmpty(payload.AudioUrl))
                {
                    // Primaria = nadie sonando ni esperando turno ahora mismo — va a entrar de
                    // una en cuanto le toque, sin fade-in. Si no, va a tener que esperar y entra
                    // suave cuando llegue su turno.
                    var isPrimary = !_audioSlotBusy && _pendingAudio.Count == 0;
                    _pendingAudio.Enqueue((ringing, payload.AudioUrl, payload.Volume, isPrimary));
                    _ = PlayNextQueuedAudioAsync();
                }
                // Pomodoro se reprograma solo (+duración) y DateTime se desactiva al sonar —
                // recargar para reflejar el estado real que ya cambió del lado del servidor.
                await LoadAlarmsAsync();
                StateHasChanged();
            });
        });

        _hubConnection.Reconnected += _ => { _hubConnected = true; return InvokeAsync(StateHasChanged); };
        _hubConnection.Reconnecting += _ => { _hubConnected = false; return InvokeAsync(StateHasChanged); };
        _hubConnection.Closed += _ => { _hubConnected = false; return InvokeAsync(StateHasChanged); };

        try
        {
            await _hubConnection.StartAsync();
            _hubConnected = true;
        }
        catch (HttpRequestException)
        {
            _hubConnected = false;
            _error = "No se pudo conectar el aviso en vivo de alarmas (¿la API está corriendo?).";
        }
    }

    // Ciclo automático (Pausa Activa): un chime corto del sistema en vez del audio largo
    // configurado — el servidor ya avanzó de fase solo, esto es puramente un aviso. No pasa
    // por _pendingAudio/_audioSlotBusy (es casi instantáneo, no vale la pena la cola para
    // esto) y se autodescarta del banner sin tocar el servidor — a diferencia de Detener,
    // que sí desactiva la alarma completa.
    private async Task PlayPhaseChimeAsync(RingingAlarm ringing)
    {
        try
        {
#if WINDOWS
            // Console.Beep en vez de MessageBeep/SystemSounds: genera el tono directo, sin
            // depender del "esquema de sonidos" de Windows (que puede tener el beep en
            // "Ninguno" o silenciado) ni de paquetes extra. Bloquea el hilo que lo llama por
            // la duración total, por eso va en un Task.Run — dos tonos cortos ("ding-dong").
            await Task.Run(() =>
            {
                Console.Beep(880, 150);
                Console.Beep(1046, 150);
            });
#endif
            // El banner queda visible 15s (a pedido del usuario — con menos no le daba tiempo a
            // leer en qué fase está) antes de autodescartarse solo.
            await Task.Delay(TimeSpan.FromSeconds(15));
        }
        catch
        {
            // Best-effort, igual que PlayAlarmSoundAsync — un chime que falla no debe romper
            // el resto del flujo.
        }
        finally
        {
            _ringingAlarms.Remove(ringing);
            StateHasChanged();
        }
    }

    // Solo un audio suena por vez (ver _pendingAudio/_audioSlotBusy) — si ya hay otra sonando,
    // esta queda en cola hasta que la anterior se pause/detenga o termine sola; el banner de
    // "sonó la alarma" sí aparece de inmediato para todas, sin esperar el turno del audio.
    private async Task PlayNextQueuedAudioAsync()
    {
        if (_audioSlotBusy) return;
        if (!_pendingAudio.TryDequeue(out var next)) return;

        if (!_ringingAlarms.Contains(next.Ringing))
        {
            // Se pausó/detuvo mientras esperaba su turno en cola — probar la siguiente.
            _ = PlayNextQueuedAudioAsync();
            return;
        }

        _audioSlotBusy = true;
        try
        {
            await PlayAlarmSoundAsync(next.Ringing, next.Url, next.IsPrimary, next.VolumePercent);
        }
        finally
        {
            // Si PlayAlarmSoundAsync nunca llegó a crear el player (descarga fallida, audio
            // roto, etc.), nadie va a llamar StopPlayback para liberar el turno — cubrir ese
            // caso acá para que la cola no quede trabada para siempre.
            if (next.Ringing.Player is null)
            {
                _audioSlotBusy = false;
                _ = PlayNextQueuedAudioAsync();
            }
        }
    }

    // Reproducción best-effort: un audio roto, sin red, o un formato no soportado no debe
    // romper el banner de la alarma ni el resto del handler de SignalR. La mecánica real
    // (descarga+caché, fix de seek, guard de stack overflow) vive en ManagedAlarmAudio —
    // compartida con AlarmNotificationService para el audio "headless".
    private async Task PlayAlarmSoundAsync(RingingAlarm ringing, string url, bool isPrimary, int? volumePercent)
    {
        try
        {
            // Si ya se apretó Pausar/Detener mientras esperábamos nuestro turno en cola, no
            // arrancar a sonar igual — ringing ya no está en la lista de alarmas sonando.
            if (!_ringingAlarms.Contains(ringing)) return;

            var managed = new ManagedAlarmAudio();
            managed.Ended += () =>
            {
                _audioSlotBusy = false;
                _ = PlayNextQueuedAudioAsync();
            };

            await managed.PlayAsync(AudioManager, url, volumePercent, fadeIn: !isPrimary,
                shouldContinue: () => _ringingAlarms.Contains(ringing),
                onPlayerCreated: () =>
                {
                    ringing.Player = managed;
                    StateHasChanged(); // saca "(esperando turno de audio)" ni bien arranca
                });
        }
        catch
        {
            // Silencioso a propósito, ver comentario arriba.
        }
    }

    private async Task PickAndUploadAudioAsync()
    {
        try
        {
            var audioType = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
            {
                { DevicePlatform.WinUI, new[] { ".mp3", ".wav", ".ogg", ".m4a" } },
                { DevicePlatform.Android, new[] { "audio/*" } }
            });
            var file = await FilePicker.Default.PickAsync(new PickOptions { FileTypes = audioType, PickerTitle = "Elegí un audio" });
            if (file is null) return;

            _uploadingAudio = true;
            var media = await MediaApi.UploadAsync(file, "audio");
            _mediaList = await MediaApi.GetMediaAsync();
            _form.AudioId = media.Id;
        }
        catch (Exception ex)
        {
            _error = $"No se pudo subir el audio: {ex.Message}";
        }
        finally
        {
            _uploadingAudio = false;
        }
    }

    private async Task SaveAlarmAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _error = "El nombre es obligatorio para crear la alarma.";
            return;
        }
        if (_form.Type == AlarmType.Pomodoro && _form.Restricted && _form.SelectedDays.Count == 0)
        {
            _error = "Elegí al menos un día para el horario restringido.";
            return;
        }
        if (_form.Type == AlarmType.Pomodoro && _form.PauseEnabled && _form.SnoozeMinutes is not > 0)
        {
            _error = "Ingresá los minutos de pausa, o desactivá la pausa activa.";
            return;
        }

        _busy = true;
        try
        {
            var isPomodoro = _form.Type == AlarmType.Pomodoro;
            var restricted = isPomodoro && _form.Restricted;
            var pauseEnabled = isPomodoro && _form.PauseEnabled;
            var daysOfWeek = _form.SelectedDays.Aggregate(AlarmDaysOfWeek.None, (acc, d) => acc | d);
            var scheduleAt = _form.Type == AlarmType.DateTime
                ? _form.ScheduleDate.ToDateTime(_form.ScheduleTime).ToUniversalTime()
                : (DateTime?)null;

            if (_editingId is Guid id)
            {
                await AlarmApi.UpdateAlarmAsync(id, new AlarmUpdateDto
                {
                    Name = _form.Name,
                    AudioId = _form.AudioId,
                    DurationMinutes = isPomodoro ? _form.DurationMinutes : null,
                    SnoozeMinutes = pauseEnabled ? _form.SnoozeMinutes : null,
                    ClearSnoozeMinutes = isPomodoro && !pauseEnabled,
                    DaysOfWeek = restricted ? daysOfWeek : null,
                    WindowStart = restricted ? _form.WindowStart : null,
                    WindowEnd = restricted ? _form.WindowEnd : null,
                    ClearWindow = isPomodoro && !restricted,
                    ScheduleAt = scheduleAt,
                    Volume = _form.Volume
                });
            }
            else
            {
                await AlarmApi.CreateAlarmAsync(new AlarmCreateDto
                {
                    Name = _form.Name,
                    Type = _form.Type,
                    DurationMinutes = isPomodoro ? _form.DurationMinutes : null,
                    ScheduleAt = scheduleAt,
                    AudioId = _form.AudioId,
                    DaysOfWeek = restricted ? daysOfWeek : null,
                    WindowStart = restricted ? _form.WindowStart : null,
                    WindowEnd = restricted ? _form.WindowEnd : null,
                    SnoozeMinutes = pauseEnabled ? _form.SnoozeMinutes : null,
                    Volume = _form.Volume
                });
            }

            ResetForm();
            await LoadAlarmsAsync();
        }
        catch (Exception ex)
        {
            _error = $"No se pudo guardar la alarma: {ex}";
        }
        finally
        {
            _busy = false;
        }
    }

    private void EditAlarm(AlarmDto alarm)
    {
        _editingId = alarm.Id;
        _form = new AlarmFormModel
        {
            Name = alarm.Name,
            Type = alarm.Type,
            DurationMinutes = alarm.DurationMinutes ?? 25,
            PauseEnabled = alarm.SnoozeMinutes is > 0,
            SnoozeMinutes = alarm.SnoozeMinutes ?? 5,
            AudioId = alarm.AudioId,
            Volume = alarm.Volume ?? 100,
            Restricted = alarm.WindowStart.HasValue && alarm.WindowEnd.HasValue,
            SelectedDays = DayOptions.Select(d => d.Flag).Where(f => alarm.DaysOfWeek.HasFlag(f)).ToHashSet(),
            WindowStart = alarm.WindowStart ?? new TimeOnly(9, 0),
            WindowEnd = alarm.WindowEnd ?? new TimeOnly(18, 0)
        };
        if (alarm.ScheduleAt.HasValue)
        {
            var local = alarm.ScheduleAt.Value.ToLocalTime();
            _form.ScheduleDate = DateOnly.FromDateTime(local);
            _form.ScheduleTime = TimeOnly.FromDateTime(local);
        }
        _error = null;
    }

    private void CancelEdit() => ResetForm();

    private void ResetForm()
    {
        _editingId = null;
        _form = new AlarmFormModel();
    }

    private void ToggleDay(AlarmDaysOfWeek day, object? isChecked)
    {
        if (isChecked is true) _form.SelectedDays.Add(day);
        else _form.SelectedDays.Remove(day);
    }

    private static string DescribeDays(AlarmDaysOfWeek days) =>
        days == AlarmDaysOfWeek.All
            ? "todos los días"
            : string.Join(", ", DayOptions.Where(d => days.HasFlag(d.Flag)).Select(d => d.Label));

    private async Task ToggleActiveAsync(AlarmDto alarm)
    {
        await AlarmApi.UpdateAlarmAsync(alarm.Id, new AlarmUpdateDto { IsActive = !alarm.IsActive });
        await LoadAlarmsAsync();
    }

    private async Task DeleteAlarmAsync(Guid id)
    {
        await AlarmApi.DeleteAlarmAsync(id);
        await LoadAlarmsAsync();
    }

    private int GetSnoozeMinutes(Guid alarmId) =>
        _snoozeMinutes.TryGetValue(alarmId, out var minutes) ? minutes : 5;

    private void SetSnoozeMinutes(Guid alarmId, string? value)
    {
        if (int.TryParse(value, out var minutes) && minutes > 0)
            _snoozeMinutes[alarmId] = minutes;
    }

    // Pospone el próximo sonido sin desactivar la alarma — para Pomodoro, la alarma sigue
    // "viva" y va a volver a sonar en N minutos en vez de en el ciclo original; para DateTime,
    // simplemente reprograma la fecha. Usa la rama de UpdateAlarm que respeta un ScheduleAt
    // explícito (ver AlarmController.UpdateAlarm — "Cambio explícito de horario (ej: snooze)").
    private async Task SnoozeAsync(AlarmDto alarm)
    {
        var minutes = GetSnoozeMinutes(alarm.Id);
        await AlarmApi.UpdateAlarmAsync(alarm.Id, new AlarmUpdateDto
        {
            IsActive = true,
            ScheduleAt = DateTime.UtcNow.AddMinutes(minutes)
        });
        await LoadAlarmsAsync();
    }

    // Detener/Pausar del banner de "sonó la alarma" — a diferencia de Pausar/Dormir en la lista
    // (manuales, en cualquier momento), estos actúan sobre la alarma que efectivamente sonó.
    // Cada banner es independiente (ver _ringingAlarms) para el caso de dos alarmas cruzadas.
    // ManagedAlarmAudio.Stop() ya es idempotente y dispara Ended (suscripto en
    // PlayAlarmSoundAsync) para liberar _audioSlotBusy/avanzar la cola — un solo lugar para esa
    // lógica, se dispare por acá o porque el audio terminó solo.
    private static void StopPlayback(RingingAlarm ringing) => ringing.Player?.Stop();

    private async Task StopRingingAlarmAsync(RingingAlarm ringing)
    {
        StopPlayback(ringing);
        _ringingAlarms.Remove(ringing);
        await AlarmApi.UpdateAlarmAsync(ringing.AlarmId, new AlarmUpdateDto { IsActive = false });
        await LoadAlarmsAsync();
    }

    // Con "Pausa activa" configurada (SnoozeMinutes), Pausar entra en ese descanso y al
    // terminar retoma el ciclo normal de DurationMinutes (el scheduler ya reprograma por
    // DurationMinutes en cada disparo, así que no hace falta ningún paso extra acá). Sin
    // pausa activa configurada, Pausar simplemente repite el propio intervalo de la alarma
    // (DurationMinutes) — "que vuelva a sonar dentro de 30 minutos, la configuración que le hice".
    private async Task PauseRingingAlarmAsync(RingingAlarm ringing)
    {
        StopPlayback(ringing);
        _ringingAlarms.Remove(ringing);

        var alarm = _alarms?.FirstOrDefault(a => a.Id == ringing.AlarmId);
        var minutes = alarm?.SnoozeMinutes
            ?? (alarm?.Type == AlarmType.Pomodoro ? alarm?.DurationMinutes : null)
            ?? 5;
        await AlarmApi.UpdateAlarmAsync(ringing.AlarmId, new AlarmUpdateDto
        {
            IsActive = true,
            ScheduleAt = DateTime.UtcNow.AddMinutes(minutes)
        });
        await LoadAlarmsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        NotificationService.IsAlarmsPageActive = false;
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }

    private class AlarmFormModel
    {
        public string Name { get; set; } = string.Empty;
        public AlarmType Type { get; set; } = AlarmType.Pomodoro;
        public int DurationMinutes { get; set; } = 25;
        public bool PauseEnabled { get; set; }
        public int? SnoozeMinutes { get; set; } = 5;
        public bool Restricted { get; set; }
        public HashSet<AlarmDaysOfWeek> SelectedDays { get; set; } = new();
        public TimeOnly WindowStart { get; set; } = new TimeOnly(9, 0);
        public TimeOnly WindowEnd { get; set; } = new TimeOnly(18, 0);
        public Guid? AudioId { get; set; }
        public int Volume { get; set; } = 100;
        public DateOnly ScheduleDate { get; set; } = DateOnly.FromDateTime(DateTime.Now.AddHours(1));
        public TimeOnly ScheduleTime { get; set; } = TimeOnly.FromDateTime(DateTime.Now.AddHours(1));
    }
}
