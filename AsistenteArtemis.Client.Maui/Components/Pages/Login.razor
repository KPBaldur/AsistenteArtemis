@page "/login"
@inject IAuthApiClient AuthApi
@inject TokenStore TokenStore
@inject AuthState AuthState
@inject NavigationManager Navigation

<Card Class="auth-card">
    <div class="overline">Artemis</div>
    <h1>Iniciar sesión</h1>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div class="form-group">
            <label for="login-user">Usuario</label>
            <InputText id="login-user" class="form-control" @bind-Value="_model.Username" />
        </div>
        <div class="form-group">
            <label for="login-pass">Contraseña</label>
            <InputText id="login-pass" class="form-control" type="password" @bind-Value="_model.Password" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="text-danger">@_error</p>
        }

        <button type="submit" class="btn btn-primary w-100" disabled="@_busy">Entrar</button>
    </EditForm>

    <p class="mt-3 mb-0"><a href="/register">¿No tenés cuenta? Registrate</a></p>
</Card>

@code {
    private readonly LoginRequest _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var auth = await AuthApi.LoginAsync(_model);
            await TokenStore.SaveSessionAsync(auth.Token, auth.RefreshToken, auth.User.Username);
            AuthState.SetAuthenticated(auth.User.Username);
            Navigation.NavigateTo("/", replace: true);
        }
        catch (HttpRequestException)
        {
            _error = "Credenciales inválidas.";
        }
        finally
        {
            _busy = false;
        }
    }
}
