DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GEMINI_API_KEY=your-gemini-api-key-here
INTERNAL_API_KEY=change-me-to-a-long-random-string-shared-with-TodoAppRoll.Api

# Cerebro de proyectos (BrainObsidian). Opcionales: sin ambos, el Brain no usa el vault.
VAULT_PATH=C:\ruta\al\clon\de\BrainObsidian
VAULT_OWNER_USER_ID=uuid-del-usuario-dueno-del-vault
# VAULT_GIT_PULL=false   # para no hacer git pull en cada sync

# Modelos de Gemini (opcionales; por defecto gemini-3.6-flash). Útil para bajar el costo del chat.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_RESEARCH_MODEL=gemini-3.6-flash
